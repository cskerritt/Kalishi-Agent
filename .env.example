# "demo" (practice money, demo.kalshi.co) or "prod" (real money, kalshi.com)
KALSHI_ENV=demo

# Credentials. Either set the generic pair below, or env-scoped pairs
# (KALSHI_DEMO_* / KALSHI_PROD_*) so both environments can coexist —
# KALSHI_ENV picks which pair is used, scoped vars win over generic ones.
KALSHI_API_KEY_ID=00000000-0000-0000-0000-000000000000
KALSHI_PRIVATE_KEY_PATH=./kalshi-private-key.pem
#KALSHI_DEMO_API_KEY_ID=
#KALSHI_DEMO_PRIVATE_KEY_PATH=./kalshi-demo-private-key.pem
#KALSHI_PROD_API_KEY_ID=
#KALSHI_PROD_PRIVATE_KEY_PATH=./kalshi-private-key.pem

# Risk limits (all money values in cents)
MAX_ORDER_COST_CENTS=2500
MAX_POSITION_CONTRACTS=100
MAX_DAILY_SPEND_CENTS=10000

# Minimum edge (in cents / percentage points) before the Claude analyst trades
MIN_EDGE_CENTS=10

# Required only for the Claude analyst (analyze / run commands)
# ANTHROPIC_API_KEY=sk-ant-...
